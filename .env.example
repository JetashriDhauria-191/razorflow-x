# ==========================================
# RAZORFLOW X — ENVIRONMENT CONFIGURATION
# ==========================================

# Razorpay Test API Credentials (Replace with your Test Keys from Razorpay Dashboard)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Application Configuration
APP_NAME=RAZORFLOW_X
ENVIRONMENT=development
PORT=8080
DEBUG=True

# Database Configuration
DATABASE_URL=sqlite:///./razorflow.db

# Fallback & Resilience Simulation Mode
USE_MOCK_FALLBACK=True
